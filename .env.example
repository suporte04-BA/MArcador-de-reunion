# ============================================================
# Agenda BA — Agenda Corporativa | BA Elétrica
# Copie este arquivo para `.env` e preencha os valores.
# NUNCA versione o arquivo `.env` real.
# ============================================================

# ---------- Ambiente ----------
NODE_ENV=development

# ---------- Aplicação ----------
APP_HOST=0.0.0.0
APP_PORT=4175
# Endereço alcançável pelos demais computadores da LAN (NUNCA use localhost aqui)
APP_BASE_URL=http://192.168.0.100:4175
APP_TIMEZONE=America/Manaus

# ---------- Banco de dados ----------
# Desenvolvimento com Docker Compose usa porta 5433.
DATABASE_URL=postgresql://agenda:change_me@localhost:5433/agenda_ba

# ---------- Sessão ----------
# Gere um valor aleatório forte, ex.: openssl rand -hex 32
SESSION_SECRET=change_me_with_random_secret
SESSION_IDLE_TIMEOUT_MINUTES=30

# ---------- E-mail (SMTP) ----------
# Ambiente local de teste: Mailpit (docker compose) em localhost:1025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Agenda BA | BA Elétrica
SMTP_FROM_ADDRESS=agenda@baeletrica.com.br

# Resend (API HTTP) — provedor preferencial. Se definido, usa Resend em vez de SMTP.
# RESEND_FROM pode ser "Nome <email@dominio-verificado.com>" ou apenas o e-mail.
RESEND_API_KEY=
RESEND_FROM=Agenda BA <noreply@seudominio.com>

# ---------- Regras de reunião ----------
MEETING_BUFFER_MINUTES=0

# ---------- Fila de e-mail ----------
EMAIL_RETRY_MAX_ATTEMPTS=8
EMAIL_RETRY_BASE_SECONDS=60

# ---------- Avatar ----------
AVATAR_MAX_BYTES=2097152
